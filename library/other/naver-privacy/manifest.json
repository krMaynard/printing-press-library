{
  "manifest_version": "0.3",
  "name": "naver-privacy-pp-mcp",
  "display_name": "Naver Privacy",
  "version": "0.0.0",
  "description": "Naver's transparency-report series — Korea's first, published since 2015 — as tidy per-category statistics instead of a CMS page blob.",
  "author": {
    "name": "CLI Printing Press"
  },
  "license": "Apache-2.0",
  "server": {
    "type": "binary",
    "entry_point": "bin/naver-privacy-pp-mcp",
    "mcp_config": {
      "command": "${__dirname}/bin/naver-privacy-pp-mcp",
      "args": []
    }
  },
  "compatibility": {
    "claude_desktop": ">=1.0.0",
    "platforms": [
      "darwin",
      "linux",
      "win32"
    ]
  }
}
